@page "/compramodelos3d/listmodelos3dparacomprar"
@using AppForSEII.Web.API
@using Microsoft.AspNetCore.Authorization

@inject IAppForSEIIAPIClient apiservice
@inject CompraModelo3DStateContainer compraState
@inject NavigationManager navigation

@attribute [Authorize]

<PageTitle>Comprar modelos 3D</PageTitle>

<div class="container">
    @* 1.Cabecera *@
    <h3>Seleccionar modelos 3D para comprar</h3>

    @* 2.Filtros(FA 2.1) *@
    <div class="row mb-3">
        <h5>Filtrar modelos 3D</h5>
        <div class="input-group">
            <span class="input-group-text">Nombre</span>
            <input type="text" class="form-control" @bind="nombre" id="nombreModelo" />
            <span class="input-group-text">Categoría</span>
            <input type="text" class="form-control" @bind="categoria" id="categoriaModelo" />
            <button class="btn btn-outline-primary" id="buscarModelos" @onclick="@BuscarModelos">Buscar</button>
        </div>
    </div>

    <div class="row">
        @* 3a.Resultados *@
        <div class="col-md-8">
            @if (modelos.Count == 0)
            {
                @* FA2.2 *@
                <p><em>No existen modelos 3D disponibles con los criterios seleccionados.</em></p>
            }
            else
            {
                <table class="table table-striped table-hover" id="TablaModelos">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th>Formato</th>
                            <th>Precio</th>
                            <th>Licencia</th>
                            <th>Caduca</th>
                            <th>Comprar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var modelo in modelos)
                        {
                            <tr id="Modelo_@modelo.Id">
                                <td>@modelo.Nombre</td>
                                <td>@modelo.Categoria</td>
                                <td>@modelo.Formato</td>
                                <td>@modelo.Precio €</td>
                                <td>@modelo.NombreLicencia</td>
                                <td>@modelo.FechaExpiracionLicencia.DateTime.ToShortDateString()</td>
                                <td>
                                    <button class="btn btn-outline-secondary" id="modeloParaComprar_@modelo.Id" @onclick="@(() => AddModelo(modelo))">Añadir</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @* 3b.Carrito *@
        <div class="col-md-4">
            <h5>Carrito: @compraState.PrecioTotal €</h5>
            @foreach (LineaCompraModelo3DDetailDTO linea in compra.LineasCompra)
            {
                <button class="btn btn-outline-secondary" id="modeloSeleccionado_@linea.Modelo3DId" @onclick="@(() => RemoveLinea(linea))">
                    Quitar @linea.NombreModelo
                </button>
            }
        </div>
    </div>

    @* 4.Acciones *@
    <div class="row">
        <div class="d-flex justify-content-between">
            <div><b>Modelos seleccionados:</b> @compra.LineasCompra.Count</div>
            <button class="btn btn-primary" id="comprarModelos" @onclick="@Comprar" disabled="@ComprarButtonDisabled">Comprar modelos 3D</button>
        </div>
    </div>
</div>

@code {
    private ICollection<Modelo3DParaCompraDTO> modelos { get; set; } = new List<Modelo3DParaCompraDTO>();
    private string? nombre;
    private string? categoria;
    private CompraModelo3DCreateDTO compra => compraState.Compra;
    private bool ComprarButtonDisabled { get { return compra.LineasCompra.Count == 0; } }
    protected override async Task OnInitializedAsync()
    {
        BuscarModelos();
    }
    protected async void BuscarModelos()
    {
        try
        {
            modelos = await apiservice.GetModelos3DParaComprarAsync(nombre, categoria);
        }
        catch (ApiException ex)
        {
            // FA 2.2: la API devuelve 404 cuando no hay modelos
            modelos = new List<Modelo3DParaCompraDTO>();
        }
        StateHasChanged();
    }
    private void AddModelo(Modelo3DParaCompraDTO modelo)
    {
        compraState.AddModelo3DToCompra(modelo);
    }
    private void RemoveLinea(LineaCompraModelo3DDetailDTO linea)
    {
        compraState.RemoveLineaCompra(linea);
    }
    private void Comprar()
    {
        navigation.NavigateTo("/compramodelos3d/createcompramodelo3d");
    }
}